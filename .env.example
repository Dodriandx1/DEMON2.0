# Required Telegram settings
API_ID=123456
API_HASH=replace_me
BOT_TOKEN=replace_me
ADMIN_IDS=123456789

# VPS Worker: keep this false when the panel runs a background worker.
KEEP_ALIVE=false

# Optional YouTube authentication.
# Export cookies from the same YouTube account in Netscape format and place
# the file at ./data/cookies.txt, or set YOUTUBE_COOKIES_B64 instead.
YOUTUBE_COOKIES_PATH=/app/data/cookies.txt
YOUTUBE_COOKIES_B64=

# Optional services
MEGA_EMAIL=
MEGA_PASSWORD=
SOCIAL_USERNAME=
SOCIAL_PASSWORD=
TWITCH_USER=
TWITCH_PASS=
TWITCH_OAUTH=